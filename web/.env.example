GEMINI_API_KEY=your_gemini_api_key_here
# Preferred for image generate — OpenRouter chat completions (modalities: image)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional preferred model slug (UI default is google/gemini-2.5-flash-image)
OPENROUTER_MODEL=
COH_APPLICATION_KEY=your_cohesivity_app_key_here
APIFY_API_TOKEN=your_apify_token_here
YOUTUBE_API_KEY=optional_youtube_data_api_key
# Set to true only if you want Cohesivity gpt-image-2 when Gemini fails (off by default)
ALLOW_COH_FALLBACK=false

# Canva Connect (OAuth) — register redirect: https://<your-host>/api/export/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Figma export — OAuth and/or server personal access token
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_ACCESS_TOKEN=
